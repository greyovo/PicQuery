# Portable scripts and checksum-pinned upstream headers use LF on every platform.
/gradlew text eol=lf
/script/model-MobileCLIP2/*.py text eol=lf
/script/model-MobileCLIP2/tests/*.py text eol=lf
/app/src/main/cpp/third_party/litert/** text eol=lf

# Curated measurement summaries are portable text.
/script/model-MobileCLIP2/results/** text eol=lf
# Export metadata and fixtures retain their published byte-level checksums.
/app/src/main/assets/mobileclip2*.json -text
/app/src/main/assets/mobileclip2*.config -text
/app/src/androidTest/assets/mobileclip2/*.json -text
